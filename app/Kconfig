# chip-module's Kconfig.defaults (rsourced below) re-declares FPU with a
# bare "default y" and no dependency. On an FPU-less core (the C6's
# rv32imac) CPU_HAS_FPU=n hides the arch prompt, so .conf assignments are
# IGNORED and that default wins -- the RISC-V reset.S then fails to
# assemble (fscsr needs the F extension). Declare a guarded default first
# (first satisfied default wins; this file parses before the rsource's
# tree): no FPU without hardware. FPU-equipped SoCs fall through to y.
config FPU
	bool
	default n if !CPU_HAS_FPU

# --- Matter operational transport: WiFi vs Thread (build-time) -------------
# The one 2.4 GHz radio can be WiFi OR 802.15.4 as the operational network,
# not both; BLE stays for commissioning either way. Thread is C6-only -- the
# classic ESP32-WROOM-32E has no 802.15.4 radio. Modeled like LEDCTRL_MODE
# (CCT/RGB): a Kconfig choice whose transport-conditional re-defaults are
# declared HERE, before the chip-module rsource and Kconfig.zephyr, so "first
# satisfied default wins" overrides the upstream defaults with no
# conflicting-value warnings (these are conditional defaults, not =y/=n
# assignments -- an inactive branch leaves the upstream default in place).
choice LEDCTRL_TRANSPORT
	prompt "Matter operational transport"
	default LEDCTRL_TRANSPORT_THREAD if SOC_SERIES_ESP32C6
	default LEDCTRL_TRANSPORT_WIFI

config LEDCTRL_TRANSPORT_WIFI
	bool "WiFi (station)"

config LEDCTRL_TRANSPORT_THREAD
	bool "Thread (802.15.4)"
	depends on SOC_SERIES_ESP32C6
	help
	  Matter-over-Thread: the OpenThread FTD stack over the esp32 802.15.4
	  radio. Requires the ieee802154 devicetree node enabled -- the C6 board
	  DTS does so by default; the wifi.conf/wifi.overlay variant flips back
	  to WiFi.

endchoice

# WiFi transport: the CHIP WiFi command set + the Zephyr WiFi driver, plus the
# neighbor-discovery / stats bits CHIP's WiFiManager (router solicitation) and
# DiagnosticDataProviderImplWiFi need. chip-module's Kconfig.defaults disables
# these (its Thread bias); re-enable them only for the WiFi transport.
config CHIP_WIFI
	default y if LEDCTRL_TRANSPORT_WIFI
	default n

config CHIP_ENABLE_WIFI_STATION
	default y if LEDCTRL_TRANSPORT_WIFI

config WIFI
	default y if LEDCTRL_TRANSPORT_WIFI
	default n

config NET_IPV6_NBR_CACHE
	default y if LEDCTRL_TRANSPORT_WIFI

config NET_IPV6_ND
	default y if LEDCTRL_TRANSPORT_WIFI

config NET_STATISTICS
	default y if LEDCTRL_TRANSPORT_WIFI

config NET_STATISTICS_WIFI
	default y if LEDCTRL_TRANSPORT_WIFI

config NET_STATISTICS_USER_API
	default y if LEDCTRL_TRANSPORT_WIFI

# Thread transport: NET_L2_OPENTHREAD selects OPENTHREAD + the 802.15.4 subsys
# (the esp32 radio driver auto-enables from the DT node). The NXP Thread
# defaults are inactive on this SoC (chip-module's Kconfig.defaults wraps them
# in `if SOC_FAMILY_NXP_RW`), so the FTD-correct options are set explicitly --
# the base OpenThread defaults (SLAAC off, Thread 1.1, MANUAL_START off) are
# wrong for Matter.
config NET_L2_OPENTHREAD
	default y if LEDCTRL_TRANSPORT_THREAD
	default n

config CHIP_OPENTHREAD_FTD
	default y if LEDCTRL_TRANSPORT_THREAD

# Matter commits the commissioned Operational Dataset and starts Thread
# itself; without manual start the L2 auto-attaches to a default network
# (~28 s stall before Matter takes over).
config OPENTHREAD_MANUAL_START
	default y if LEDCTRL_TRANSPORT_THREAD

# Form an off-mesh-routable (OMR/GUA) address from the border router's on-mesh
# prefix -- Matter operational traffic routed through the BR needs it.
config OPENTHREAD_SLAAC
	default y if LEDCTRL_TRANSPORT_THREAD

# BLE (commissioning) + 802.15.4 (operational) share the one 2.4 GHz radio;
# software coexistence arbitrates them during the commissioning->Thread
# handoff. The SoC already defaults this y for IEEE802154_ESP32 && BT_ESP32
# (zephyr/soc/espressif/common/Kconfig); pin it to intent.
config ESP32_SW_COEXIST_ENABLE
	default y if LEDCTRL_TRANSPORT_THREAD && BT

# Router-eligible FTD (mains-powered, not a sleepy MTD) and Thread 1.4 (Matter
# expects 1.3+; base OpenThread default is 1.1). Named choices re-opened to add
# a transport-conditional default, parsed before the upstream definition so it
# wins. (OPENTHREAD_DEVICE_TYPE already defaults to FTD as its first member, so
# only CHIP_OPENTHREAD_FTD above needs pinning for the GN arg; the version
# choice genuinely needs the bump.)
choice OPENTHREAD_STACK_VERSION
	default OPENTHREAD_THREAD_VERSION_1_4 if LEDCTRL_TRANSPORT_THREAD
endchoice
# ---------------------------------------------------------------------------

# Opt into CHIP's Zephyr defaults (deterministic workspace-relative path;
# orsource with env vars silently no-ops). Its Thread-biased defaults are
# overridden above per the selected LEDCTRL_TRANSPORT (notably
# NET_L2_OPENTHREAD, which chip-module defaults y).
rsource "../modules/connectedhomeip/config/zephyr/chip-module/Kconfig.defaults"

# The Espressif WiFi/BT drivers contribute promptless HEAP_MEM_POOL_ADD_SIZE_*
# defaults (40960 + 25600 on Zephyr 4.3; 4.4 raises WiFi to 51200 citing
# real allocation failures) that set the floor of the statically-allocated
# kernel heap — above measured need on the classic ESP32 (peak ~42K with
# both radios active and trimmed driver buffers). Kconfig takes the first
# default it sees, and this file is parsed before the driver tree, so
# re-declaring the symbols here lowers the floor. dram0_0_seg is 136K
# total; every KB counts. Re-measure before trusting these numbers on a
# new Zephyr/hal pin. Classic ESP32 only: the C6's unified 512K SRAM
# doesn't need the diet, so it keeps the driver defaults (51200 + 50000).
config HEAP_MEM_POOL_ADD_SIZE_ESP_WIFI
	int
	default 24576 if SOC_SERIES_ESP32

config HEAP_MEM_POOL_ADD_SIZE_ESP_BT
	int
	default 16384 if SOC_SERIES_ESP32

choice LEDCTRL_MODE
	prompt "LED strip type"
	default LEDCTRL_MODE_CCT

config LEDCTRL_MODE_CCT
	bool "2-channel tunable white (CCT) strip"

config LEDCTRL_MODE_RGB
	bool "3-channel RGB strip"

endchoice

config LEDCTRL_PROV_SHELL
	bool "Pairing-code provisioning shell commands"
	depends on SHELL
	help
	  matter_prov set/show/clear commands writing the chip-fct settings
	  keys read by the commissionable-data provider. RAM does not allow
	  the shell in the production image; enable via the prov.conf build
	  variant, provision, then flash the production image (the settings
	  partition survives reflashing).

if LEDCTRL_MODE_CCT

config LEDCTRL_CH_WARM
	int "led_pwm channel index of the warm-white strip channel"
	default 1

config LEDCTRL_CH_COOL
	int "led_pwm channel index of the cool-white strip channel"
	default 0

config LEDCTRL_MIREDS_COOL
	int "Coolest supported color temperature (mireds)"
	default 154

config LEDCTRL_MIREDS_WARM
	int "Warmest supported color temperature (mireds)"
	default 370

endif # LEDCTRL_MODE_CCT

config LEDCTRL_RECLAIM_BT_DRAM_AFTER_COMMISSIONING
	bool "Reclaim the BT-controller DRAM reserve after commissioning"
	depends on BT && CHIP_MALLOC_SYS_HEAP && SOC_SERIES_ESP32
	default y
	select MULTI_HEAP
	select SYS_HEAP_RUNTIME_STATS
	help
	  After the device is fully provisioned and joined to WiFi, tear down the
	  BLE stack (bt_disable) and hand the ~54.8 KiB CONFIG_ESP32_BT_RESERVE_DRAM
	  region to the CHIP sys_heap as a second heap bank (see chip-patches
	  0005/0006). This makes BLE a one-way, commissioning-only resource: it
	  CANNOT be re-enabled without a reboot, so additional-fabric commissioning
	  must happen on-network (PASE over IP, which commissioners support). A
	  factory reset reboots, restoring BLE for re-commissioning.

config LEDCTRL_PSA_ESP_ECC_DRIVER
	bool "P-256 point multiplication on the ECC accelerator"
	depends on SOC_SERIES_ESP32C6 && CHIP_CRYPTO_PSA
	default y
	help
	  Register a PSA transparent driver (app/src/crypto, dispatch hook in
	  tf-psa-crypto-patches/0001) that feeds P-256 point multiplication to
	  the C6's ECC engine: CASE ECDH, ECDSA sign and verify, and
	  public-key derivation. SPAKE2+ stays on the builtin software path,
	  which remains fully compiled — the driver deliberately defines no
	  MBEDTLS_PSA_ACCEL_* macros, and rare verify corner cases fall back
	  to it.

source "Kconfig.zephyr"
