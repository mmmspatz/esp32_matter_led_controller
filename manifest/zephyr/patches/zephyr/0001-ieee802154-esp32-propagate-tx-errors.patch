 	 */
 	struct k_sem tx_wait;
 
+	/* Result of the last transmission, set by the transmit_done /
+	 * transmit_failed callbacks before they post tx_wait.
+	 */
+	esp_ieee802154_tx_error_t tx_result;
+
 	/* TX buffer. First byte is PHR (length), remaining bytes are
 	 * MPDU data.
 	 */
